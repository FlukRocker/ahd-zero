APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# IMPORTANT: when sharing Redis with another app, set a unique prefix per app
# so cache keys don't collide. Default derives from APP_NAME if unset.
# CACHE_PREFIX=ahdv2

# When sharing a Redis instance, point each app to a different DB number to
# guarantee key isolation even if prefixes are misconfigured.
# REDIS_DB=0
# REDIS_CACHE_DB=1

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Set to false to hard-disable member registration (overrides admin toggle).
REGISTRATION_ENABLED=true

# Inertia SSR — change port if a co-tenant on the same host already uses 13714.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_PORT=13715
# INERTIA_SSR_URL=http://127.0.0.1:13715

# Akuma player ads embed
# AKUMA_PLAYER_ADS_EMBED=https://anime-hdzero.com/player/embed.php
# AKUMA_PLAYER_URL=http://65.108.61.69:3002
# AKUMA_PLAYER_TOKEN=
# AKUMA_PLAYER_DOMAIN=https://akuma-player.xyz
